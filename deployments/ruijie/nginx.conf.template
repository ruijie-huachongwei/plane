map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${APP_DOMAIN};

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $space_upstream space:3000;
    set $admin_upstream admin:3000;
    set $live_upstream live:3000;
    set $api_upstream api:8000;
    set $web_upstream web:3000;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size ${FILE_SIZE_LIMIT};
    large_client_header_buffers 8 4m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /spaces {
        return 308 /spaces/;
    }

    location ^~ /spaces/ {
        proxy_pass http://$space_upstream$request_uri;
    }

    location = /god-mode {
        return 308 /god-mode/;
    }

    location ^~ /god-mode/ {
        proxy_pass http://$admin_upstream$request_uri;
    }

    location = /live {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://$live_upstream$request_uri;
    }

    location ^~ /live/ {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://$live_upstream$request_uri;
    }

    location ~ ^/(api|auth|static)(/|$) {
        proxy_pass http://$api_upstream$request_uri;
    }

    location / {
        proxy_pass http://$web_upstream$request_uri;
    }
}